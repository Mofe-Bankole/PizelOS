---
import { findMedia, mediaUrl, pick } from "../../lib/media";

interface Props {
  cover?: string;
  uid: string;
}

const { cover, uid } = Astro.props;
const media = cover ? findMedia(cover) : undefined;
const thumb = media ? mediaUrl(pick(media.variants.webp, 480).src) : null;
---

<svg class="folder-icon" viewBox="0 0 120 100" aria-hidden="true">
  <defs>
    <linearGradient id={`${uid}-back`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--folder-back-top)" />
      <stop offset="1" stop-color="var(--folder-back-bottom)" />
    </linearGradient>
    <linearGradient id={`${uid}-front`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--folder-front-top)" />
      <stop offset="1" stop-color="var(--folder-front-bottom)" />
    </linearGradient>
    <clipPath id={`${uid}-paper`}><rect x="18" y="18" width="84" height="62" rx="4" /></clipPath>
  </defs>
  <path d="M8 22c0-5 3-8 8-8h28c3 0 4.6 1 6.3 3l3.4 4H104c5 0 8 3 8 8v54c0 5-3 8-8 8H16c-5 0-8-3-8-8Z" fill={`url(#${uid}-back)`} />
  {thumb ? (
    <g clip-path={`url(#${uid}-paper)`} transform="rotate(-3 60 50)">
      <rect x="18" y="18" width="84" height="62" fill="#fff" />
      <image href={thumb} x="18" y="18" width="84" height="62" preserveAspectRatio="xMidYMid slice" />
    </g>
  ) : (
    <rect x="18" y="22" width="84" height="58" rx="4" fill="#fff" opacity=".9" />
  )}
  <path d="M6 40c0-4.4 3.2-7 7.5-7h93c4.3 0 7.5 2.6 7.5 7l-2.6 45c-.3 4.6-3.4 7-7.8 7H16.4c-4.4 0-7.5-2.4-7.8-7Z" fill={`url(#${uid}-front)`} />
  <path d="M7 40.5c.2-3.9 3-6.2 6.8-6.2h92.4c3.8 0 6.6 2.3 6.8 6.2" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="1.2" />
</svg>
