---
import type { MenuDef } from "../MenuBar/menus";

interface Props {
  menu: MenuDef;
}

const { menu } = Astro.props;
---

<div class="menu glass glass-strong" role="menu" id={`menu-${menu.id}`} aria-labelledby={`menu-title-${menu.id}`} hidden>
  {menu.items.map(item =>
    item.type === "separator" ? (
      <div class="menu-separator" role="separator" />
    ) : item.href && !item.disabled ? (
      <a
        class="menu-item"
        role="menuitem"
        tabindex="-1"
        href={item.href}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener" : undefined}
      >
        <span class="menu-label">{item.label}</span>
        {item.shortcut && <span class="menu-shortcut">{item.shortcut}</span>}
      </a>
    ) : (
      <button
        class="menu-item"
        role="menuitem"
        tabindex="-1"
        type="button"
        data-action={item.action}
        disabled={item.disabled}
        aria-disabled={item.disabled ? "true" : undefined}
      >
        <span class="menu-label">{item.label}</span>
        {item.shortcut && <span class="menu-shortcut">{item.shortcut}</span>}
      </button>
    )
  )}
</div>

<style>
  .menu {
    position: absolute;
    top: calc(var(--menubar-h) + var(--menu-gap-y));
    left: 0;
    min-width: var(--menu-min-w);
    padding: var(--menu-pad);
    border-radius: var(--menu-radius);
    color: var(--glass-text);
    font-size: var(--menu-text);
    font-weight: 400;
    letter-spacing: var(--track-13);
    text-shadow: none;
    z-index: 1000;
    transform-origin: top left;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-item {
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--menu-row-h);
    padding: 0 var(--menu-row-pad-x);
    border-radius: var(--menu-row-radius);
    text-align: left;
    white-space: nowrap;
    outline: none;
  }
  .menu-label {
    flex: 1;
  }
  .menu-shortcut {
    margin-left: var(--menu-shortcut-gap);
    color: var(--glass-text-dim);
    letter-spacing: 0.04em;
  }
  .menu-item[aria-disabled="true"] {
    color: var(--glass-text-dim);
  }
  .menu-item:not([aria-disabled="true"]).is-active {
    background: var(--accent);
    color: var(--accent-text);
  }
  .menu-item.is-active .menu-shortcut {
    color: color-mix(in srgb, var(--accent-text) 75%, transparent);
  }
  .menu-separator {
    height: var(--hairline);
    margin: var(--menu-separator-margin);
    background: color-mix(in srgb, var(--glass-text) 14%, transparent);
  }
</style>
