---
import "../../tokens/tokens.css";
import "./global.css";
import "../Glass/glass.css";
import "../Window/window.css";
import "../../components/artwork.css";
import "../../apps/apps.css";
import Wallpaper from "../Wallpaper/Wallpaper.astro";
import Boot from "../Boot/Boot.astro";
import MenuBar from "../MenuBar/MenuBar.astro";
import Dock from "../Dock/Dock.astro";
import Overlay from "../../dev/Overlay/Overlay.astro";
import wallpapers from "../../data/wallpaper.json";
import early from "./early.inline.js?raw";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = "Pizelxx",
  description = "Pizelxx — web3 designer. Memes, banners, brand art and bounty-winning pieces.",
  image = "/og/pizelxx.jpg",
  imageAlt = "Pizelxx's portfolio, a desktop you can explore",
  noindex = false,
} = Astro.props;
const w = wallpapers.items[wallpapers.active as keyof typeof wallpapers.items];
const site = Astro.site ?? new URL("https://pizelos.pages.dev");
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonical = new URL(cleanPath, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="en" style={`--wallpaper-blur:url("/wallpaper/${w.blurred}")`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={w.color} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pizelxx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Pizelxx" />
    <meta name="twitter:creator" content="@Pizelxx" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline set:html={early} />
  </head>
  <body>
    <Wallpaper />
    <Boot />
    <MenuBar />
    <main class="desktop" id="desktop">
      <slot />
    </main>
    <Dock />
    {import.meta.env.DEV && <Overlay />}
    <script>
      import "../../apps/client";
      import { initWindowManager } from "../Window/window-manager";
      initWindowManager(document.getElementById("desktop")!);
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        const register = () =>
          navigator.serviceWorker
            .register("/sw.js")
            .then(() => navigator.serviceWorker.ready)
            .then(reg => {
              const urls = performance
                .getEntriesByType("resource")
                .map(e => new URL(e.name))
                .filter(u => u.origin === location.origin && /^\/(_astro|media|wallpaper|fonts)\//.test(u.pathname))
                .map(u => u.pathname);
              reg.active?.postMessage({ type: "cache", urls: [...new Set(urls)] });
            })
            .catch(() => {});
        if (document.documentElement.dataset.boot === "none") register();
        else document.addEventListener("shell:booted", register, { once: true });
      }
    </script>
  </body>
</html>

<style>
  .desktop {
    position: fixed;
    inset: var(--menubar-h) 0 0 0;
    z-index: 10;
  }
</style>
