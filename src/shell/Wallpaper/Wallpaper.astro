---
import wallpapers from "../../data/wallpaper.json";
import pickScript from "./pick.inline.js?raw";

const w = wallpapers.items[wallpapers.active as keyof typeof wallpapers.items] as {
  aspect: number; color: string; placeholder: string; pixel?: boolean; formats?: string[];
  variants: ({ w: number } & Record<string, string | number>)[];
};
const base = "/wallpaper/";
const formats = w.formats ?? ["avif", "webp", "jpeg"];
const fallbackFormat = formats[formats.length - 1];
const sourceFormats = formats.slice(0, -1);
const data = { base, aspect: w.aspect, variants: w.variants, fallback: fallbackFormat, pixel: !!w.pixel, formats };
const fallback = w.variants.find(v => v.w >= 1920) ?? w.variants[0];
---

<div
  class="wallpaper"
  style={`--wallpaper-color:${w.color};--wallpaper-placeholder:url("${w.placeholder}")`}
  data-wallpaper={JSON.stringify(data)}
  aria-hidden="true"
>
  <picture>
    {sourceFormats.map(f => <source type={`image/${f}`} data-format={f} />)}
    <img alt="" decoding="async" fetchpriority="high" draggable="false" />
  </picture>
  <noscript><img class="noscript" src={base + fallback[fallbackFormat]} alt="" /></noscript>
</div>
<script is:inline set:html={pickScript} />

<style>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--wallpaper-color) var(--wallpaper-placeholder) center / cover no-repeat;
    overflow: hidden;
  }
  .wallpaper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--wallpaper-fade) ease-out;
  }
  .wallpaper:global(.is-loaded) img,
  .wallpaper img.noscript {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .wallpaper img {
      transition-duration: 1ms;
    }
  }
</style>
