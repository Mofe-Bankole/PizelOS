---
/**
 * The PSD breakdown: each layer from the pipeline, absolutely positioned on the
 * original canvas. Layers are listed bottom → top. The flattened image sits on top
 * at rest, so the collapsed state matches Photoshop exactly even where the layer
 * split loses detail (effects, adjustments); the animation fades it out before
 * pulling the layers apart.
 *
 * Animation lives in the page script, not here; it should `await whenAllReady(stack)`
 * before building its timeline.
 */
import { getMedia, mediaUrl, pick, srcset } from "../lib/media";

interface Props { id: string; alt: string; priority?: boolean }
const { id, alt, priority = false } = Astro.props;
const m = getMedia(id);
if (!m.layers) throw new Error(`"${id}" has no layers. Add it to "layered" in assets.config.json and run \`npm run assets\`.`);
const { canvas, items } = m.layers;
const loading = priority ? "eager" : "lazy";
---

<div class="stack" style={`aspect-ratio:${canvas.w}/${canvas.h};--ph:${m.color}`} data-stack={id}>
  {items.map((l, i) => (
    <div class="layer" data-layer={l.name} style={`z-index:${i}`}>
      <img
        src={mediaUrl(l.src)}
        alt=""
        loading={loading}
        decoding="async"
        style={`left:${l.x}%;top:${l.y}%;width:${l.w}%;height:${l.h}%;opacity:${l.opacity}${l.blend ? `;mix-blend-mode:${l.blend}` : ""}`}
      />
    </div>
  ))}
  <picture class="flat" style={`z-index:${items.length}`}>
    <source type="image/avif" srcset={srcset(m.variants.avif)} sizes="(max-width: 760px) 90vw, 60vh" />
    <img src={mediaUrl(pick(m.variants.webp, 1600).src)} alt={alt} width={m.width} height={m.height} loading={loading} fetchpriority={priority ? "high" : "auto"} decoding="async" />
  </picture>
</div>

<style>
  .stack { position: relative; transform-style: preserve-3d; background: var(--ph); }
  .layer { position: absolute; inset: 0; transform-style: preserve-3d; }
  .layer img { position: absolute; display: block; }
  .flat, .flat img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
