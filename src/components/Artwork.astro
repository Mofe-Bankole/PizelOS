---
import "./artwork.css";
import { getMedia, mediaUrl, pick, srcset } from "../lib/media";

interface Props {
  id: string;
  alt: string;
  sizes?: string;
  priority?: boolean;
  fit?: "natural" | "contain" | "cover";
  class?: string;
}

const { id, alt, sizes = "(max-width: 760px) 100vw, (max-width: 1200px) 50vw, 33vw", priority = false, fit = "natural", class: cls } = Astro.props;
const m = getMedia(id);
const fallback = pick(m.variants.webp, 960);
const style = fit === "natural" ? `aspect-ratio:${m.width}/${m.height};--ph:${m.color}` : `--ph:${m.color}`;
---

<figure class:list={["artwork", `fit-${fit}`, cls]} style={style} data-thumbhash={fit === "contain" ? undefined : m.thumbhash}>
  <picture>
    <source type="image/avif" srcset={srcset(m.variants.avif)} sizes={sizes} />
    <source type="image/webp" srcset={srcset(m.variants.webp)} sizes={sizes} />
    <img
      src={mediaUrl(fallback.src)}
      alt={alt}
      width={m.width}
      height={m.height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
      draggable="false"
    />
  </picture>
</figure>
