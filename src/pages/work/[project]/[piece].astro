---
import Desktop from "../../../shell/Desktop/Desktop.astro";
import Preview from "../../../apps/preview/Preview.astro";
import { getWorks } from "../../../lib/works";
import { ogCard } from "../../../lib/media";

export async function getStaticPaths() {
  return (await getWorks({ includeHidden: true })).map(w => {
    const [project, piece] = w.id.split("/");
    return {
      params: { project, piece },
      props: { id: w.id, title: w.title, client: w.clientName, description: w.description },
    };
  });
}

const { id, title, client, description } = Astro.props;
---

<Desktop
  title={`${title} — ${client} — Pizelxx`}
  description={description || `${title} by Pizelxx for ${client}.`}
  image={ogCard(id)}
  imageAlt={`${title} by Pizelxx for ${client}`}
>
  <Preview id={id} />
</Desktop>
