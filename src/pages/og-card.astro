---
import "../tokens/tokens.css";
import "../shell/Desktop/global.css";
import "../shell/Glass/glass.css";
import wallpapers from "../data/wallpaper.json";
import profile from "../data/profile.json";
import Monogram from "../icons/Monogram.astro";
import AppIcon from "../icons/AppIcon.astro";
import { apps } from "../icons/apps";
import { getWorks } from "../lib/works";

const w = wallpapers.items[wallpapers.active as keyof typeof wallpapers.items] as { variants: ({ w: number } & Record<string, string | number>)[]; formats?: string[] };
const fmt = (w.formats ?? ["webp"])[0];
const bg = `/wallpaper/${w.variants[0][fmt]}`;
const works = await getWorks();
const projects = new Set(works.map(x => x.project.id)).size;
---

<!doctype html>
<html lang="en" data-glass="medium" data-appearance="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div class="card" style={`background-image:url(${bg})`}>
      <div class="shade"></div>
      <div class="panel glass glass-strong">
        <div class="badge"><Monogram size={34} /></div>
        <div class="text">
          <h1>{profile.name}</h1>
          <p>{profile.role} · {works.length} pieces · {projects} projects</p>
        </div>
      </div>
      <div class="dock glass">
        {apps.map(app => <span class="icon"><AppIcon app={app} /></span>)}
      </div>
      <div class="url">pizelos.pages.dev</div>
    </div>
  </body>
</html>

<style is:global>
  html, body {
    overflow: hidden;
    background: #000;
  }
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    background: #000 0% 58% / 140% auto no-repeat;
    image-rendering: pixelated;
    overflow: hidden;
    font-family: var(--font-display);
  }
  .shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 90% at 30% 45%, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.55));
  }
  .panel {
    position: absolute;
    left: 64px;
    top: 120px;
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 28px 40px 28px 28px;
    border-radius: 30px;
    --glass-tint-strong: rgba(250, 248, 245, 0.72);
    color: #111;
  }
  .badge {
    width: 84px;
    height: 84px;
    border-radius: 22px;
    display: grid;
    place-items: center;
    background: #0b0b0d;
    color: #fff;
  }
  h1 {
    margin: 0;
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .text p {
    margin: 10px 0 0;
    font-size: 24px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.6);
  }
  .dock {
    position: absolute;
    left: 64px;
    bottom: 56px;
    display: flex;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 30px;
  }
  .icon {
    width: 64px;
    height: 64px;
  }
  .url {
    position: absolute;
    right: 40px;
    top: 30px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 22px;
    font-weight: 600;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
</style>
