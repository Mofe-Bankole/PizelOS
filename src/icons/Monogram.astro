---
import { MONOGRAM } from "./monogram";

interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: cls } = Astro.props;
const p = MONOGRAM.pixel;
---

<svg class={cls} viewBox={`0 0 ${MONOGRAM.size} ${MONOGRAM.size}`} width={size} height={size} aria-hidden="true" fill="currentColor">
  <path d={MONOGRAM.letter} />
  <rect x={p.x} y={p.y} width={p.size} height={p.size} rx={p.radius} />
</svg>
